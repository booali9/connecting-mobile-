# The backend this app talks to. Unset, the app runs on its seeded demo
# data and reaches no network.
#
# `localhost` here means the phone, not the machine running the server:
#   iOS simulator      http://localhost:5000
#   Android emulator   http://10.0.2.2:5000
#   a real device      http://<your machine's LAN IP>:5000
#
# The value is inlined into the bundle at build time, so a change needs a
# full reload before the app sees it. Nothing secret belongs here.
EXPO_PUBLIC_API_URL=http://localhost:5000
